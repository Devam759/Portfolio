# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Notification Recipient (where contact submissions get delivered)
NOTIFICATION_RECIPIENT=devamg759@gmail.com

# Email Provider Configuration (Brevo Recommended for 100% deliverability)
# Option A: Brevo REST API (Fastest & Most reliable, free 300 emails/day)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_brevo_email@gmail.com

# Option B: Brevo SMTP Relay
EMAIL_SERVICE=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@gmail.com
BREVO_SMTP_KEY=xsmtpsib-your_brevo_smtp_key_here

# Option C: Legacy Gmail SMTP Fallback
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_google_app_password

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
